Options -MultiViews
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /index.html becomes /, including index files in subdirectories.
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
    RewriteRule ^(?:.*/)?index\.html$ /%1 [R=301,L,NE]

    # Redirect every other directly requested .html URL to its clean URL.
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Internally serve the matching physical HTML file without changing the URL.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [END]
</IfModule>
